generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique // lms, ebook, ppt, etc.
  isActive Boolean @default(true)

  apiKeys     ApiKey[]
  users       ProductUser[]
  orders      Order[]
  requestLogs ApiRequestLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String @id @default(uuid())
  productId String

  keyName     String // e.g., "production-key", "staging-key"
  keyHash     String @unique // bcrypt hash of the actual key
  keyPrefix   String // e.g., "pk_live_lms_" for quick lookup
  environment String @default("production") // production, staging, development

  permissions     String[] // ["charge", "refund", "read"]
  rateLimitPerMin Int      @default(100)

  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?

  product     Product            @relation(fields: [productId], references: [id])
  requestLogs ApiRequestLog[]
  rateLimits  RateLimitTracker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([keyPrefix])
  @@index([productId])
}

model RateLimitTracker {
  id       String @id @default(uuid())
  apiKeyId String

  windowStart  DateTime // Start of the current minute window
  requestCount Int      @default(0)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, windowStart])
  @@index([windowStart])
}

model ApiRequestLog {
  id        String  @id @default(uuid())
  apiKeyId  String?
  productId String?

  endpoint       String
  method         String
  statusCode     Int?
  ipAddress      String?
  userAgent      String?
  requestBody    Json?
  responseTimeMs Int?
  errorMessage   String?

  apiKey  ApiKey?  @relation(fields: [apiKeyId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([apiKeyId])
  @@index([productId])
  @@index([createdAt])
}

model ProductUser {
  id             String  @id @default(uuid())
  productId      String
  externalUserId String // userId from calling product
  email          String?

  product Product @relation(fields: [productId], references: [id])
  orders  Order[]

  createdAt DateTime @default(now())

  @@unique([productId, externalUserId])
}

model Order {
  id            String @id @default(uuid())
  productId     String
  productUserId String

  referenceId    String // order id from product system
  idempotencyKey String? @unique // prevent duplicate charges

  amount   Int // smallest currency unit (cents / paise)
  currency String      @default("USD")
  status   OrderStatus @default(CREATED)

  product     Product     @relation(fields: [productId], references: [id])
  productUser ProductUser @relation(fields: [productUserId], references: [id])

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, referenceId])
  @@index([idempotencyKey])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String

  name     String
  sku      String?
  quantity Int     @default(1)
  price    Int // per unit price (smallest currency unit)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id      String @id @default(uuid())
  orderId String

  tilledPaymentId String?
  method          PaymentMethod
  status          PaymentStatus
  amount          Int

  rawRequest  Json?
  rawResponse Json?

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  createdAt DateTime @default(now())

  @@index([tilledPaymentId])
}

model Refund {
  id        String @id @default(uuid())
  paymentId String

  tilledRefundId String?
  amount         Int
  status         RefundStatus
  reason         String?

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([tilledRefundId])
}

model WebhookEvent {
  id        String  @id @default(uuid())
  eventType String
  tilledId  String
  payload   Json
  processed Boolean @default(false)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([eventType, tilledId])
  @@index([processed])
}

enum OrderStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PaymentMethod {
  CARD
  ACH
  WALLET
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}
